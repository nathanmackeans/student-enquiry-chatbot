# Copy this file to .env.local and fill in your own values.
# .env.local is already git-ignored by create-next-app, so your keys stay
# out of version control.

# Supabase project settings -> API -> "Publishable key" (safe to expose to
# the browser -- this used to be called the "anon key" in older projects).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Supabase project settings -> API -> "Secret key" (used to be called the
# "service_role key"). NEVER expose this in the browser or commit it --
# see lib/supabase/admin.js.
SUPABASE_SECRET_KEY=sb_secret_your-key

# platform.openai.com -> API keys
OPENAI_API_KEY=sk-your-openai-key
